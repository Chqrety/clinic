# ==========================================
# CLINIC ACCOUNTING & ERP ENVIRONMENT CONFIG
# ==========================================

APP_NAME=clinic-accounting
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL Configuration (Direct Native Connection)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clinic_accounting
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT
JWT_SECRET=super_secret_jwt_encryption_key_change_me
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Accounting Core Settings
BASE_CURRENCY=IDR
FISCAL_YEAR_START_MONTH=1
AUTO_POSTING=true

