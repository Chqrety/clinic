      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Saat dokter klik 'Selesai & Kirim Resep':\n  - Stok obat/vaksin langsung status RESERVED\n  - Notifikasi suara / live chime berbunyi di modul Apotek\n  - Draft tagihan otomatis masuk ke modul Kasir\n  - Rekam Medis (SOAP) tersimpan permanen",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 Saat dokter klik 'Selesai & Kirim Resep':\n  - Stok obat/vaksin langsung status RESERVED\n  - Notifikasi suara / live chime berbunyi di modul Apotek\n  - Draft tagihan otomatis masuk ke modul Kasir\n  - Rekam Medis (SOAP) tersimpan permanen",
      "lineHeight": 1.25
    },
