# Salin file ini menjadi .env di server VPS:
# cp .env.example .env

# Web Server (Port yang dibuka ke publik/host)
PORT=80

# Database Configuration (PostgreSQL 16)
DB_USER=postgres
DB_PASSWORD=GantiDenganPasswordSangatAman123!
DB_NAME=clinic_accounting
DB_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=GantiDenganStringRahasiaPanjangMinimal32KarakterAcak!

# Core Accounting Settings
BASE_CURRENCY=IDR
FISCAL_YEAR_START_MONTH=1
AUTO_POSTING=true
